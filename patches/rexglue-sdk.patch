+        if (!submit_thread_running_) {
+          return;
+        }
+        continue;
+      }
+      job = std::move(submit_queue_.front());
+      submit_queue_.pop_front();
+    }
+    job.allocator->Reset();
+    command_list_->Reset(job.allocator, nullptr);
+    deferred_command_list_.ExecuteStream(job.stream.data(), job.stream.size(), command_list_,
+                                         command_list_1_);
+    command_list_->Close();
+    ID3D12CommandList* execute_command_lists[] = {command_list_};
+    direct_queue->ExecuteCommandLists(1, execute_command_lists);
+    direct_queue->Signal(submission_fence_, job.fence_value);
+    {
+      std::lock_guard<std::mutex> lock(submit_mutex_);
+      job.stream.clear();
+      if (submit_stream_pool_.size() < kMaxQueuedSubmits + 1) {
+        submit_stream_pool_.push_back(std::move(job.stream));
+      }
+      --submit_jobs_in_flight_;
+    }
+    submit_done_cv_.notify_all();
+  }
+}
+
+void D3D12CommandProcessor::DrainSubmitQueue() {
+  std::unique_lock<std::mutex> lock(submit_mutex_);
+  submit_done_cv_.wait(lock, [this] { return submit_jobs_in_flight_ == 0; });
+}
