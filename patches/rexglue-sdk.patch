+// File read statistics (info log every 5 s while the title reads): how much the game loads and how
+// long the reads take (streaming analysis).
+namespace {
+struct ReadStats {
+  std::mutex mutex;
+  uint64_t reads = 0, bytes = 0, total_us = 0, max_us = 0;
+  std::unordered_map<std::string, std::pair<uint64_t, uint64_t>> by_file;  // path -> (us, bytes)
+  std::chrono::steady_clock::time_point last = std::chrono::steady_clock::now();
+} g_read_stats;
+
+void RecordRead(const std::string& path, uint64_t bytes, uint64_t us) {
+  std::lock_guard<std::mutex> lock(g_read_stats.mutex);
+  auto& st = g_read_stats;
+  ++st.reads;
+  st.bytes += bytes;
+  st.total_us += us;
+  st.max_us = std::max(st.max_us, us);
+  auto& f = st.by_file[path];
+  f.first += us;
+  f.second += bytes;
+  auto now = std::chrono::steady_clock::now();
+  if (now - st.last < std::chrono::seconds(5)) return;
+  st.last = now;
+  std::vector<std::pair<std::string, std::pair<uint64_t, uint64_t>>> top(st.by_file.begin(), st.by_file.end());
+  std::sort(top.begin(), top.end(), [](const auto& a, const auto& b) { return a.second.first > b.second.first; });
+  std::string files;
+  for (size_t i = 0; i < top.size() && i < 4; ++i)
+    files += fmt::format(" {} ({:.1f} ms, {:.1f} MB)", top[i].first, top[i].second.first / 1000.0,
+                         top[i].second.second / 1048576.0);
+  REXKRNL_INFO("File reads 5s: {} reads, {:.1f} MB, {:.1f} ms total, slowest {:.1f} ms | by time:{}", st.reads,
+               st.bytes / 1048576.0, st.total_us / 1000.0, st.max_us / 1000.0, files);
+  st.reads = st.bytes = st.total_us = st.max_us = 0;
+  st.by_file.clear();
+}
